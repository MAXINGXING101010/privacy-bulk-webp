# ============================================================
# PrivacyBulkWebP — Environment Variables
# Copy this file to .env.local (development) or set in Vercel Dashboard
# ============================================================

# ── Database (Vercel Postgres) ──────────────────────────────
# Automatically set when linking a Postgres database in Vercel
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# ── JWT Secret ──────────────────────────────────────────────
# Generate a strong random string (min 32 chars)
# Example: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── PayPal (Sandbox for testing, then switch to production) ─
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Production: https://api-m.paypal.com

# PayPal Plan IDs (created in PayPal Dashboard)
PAYPAL_PLAN_PERSONAL=your-personal-plan-id
PAYPAL_PLAN_PRO=your-pro-plan-id

# ── Google AdSense ──────────────────────────────────────────
# Your AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX)
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
# Set to "true" to enable ads, "false" to disable globally
ADSENSE_ENABLED=true

# ── App Config ──────────────────────────────────────────────
# Frontend base URL (for CORS and redirects)
APP_URL=http://localhost:5173
# Production: https://yourdomain.com

# Cookie settings
COOKIE_DOMAIN=localhost
# Production: .yourdomain.com
